#!/usr/bin/env python3
"""
kbdlightd - keyboard backlight daemon for Clevo laptops (NP50RNA and similar)

Why this daemon is needed:
  The tuxedo_keyboard kernel module creates the LED /sys/class/leds/rgb:kbd_backlight
  and REPORTS the Fn+volume up/down keys as KEY_KBDILLUMUP/DOWN events, but it does
  NOT change the brightness itself (this is specific to RGB keyboards). So a
  userspace process is needed to catch those events and write to the LED.

Why it watches MULTIPLE devices:
  If keyd (a key remapper) runs with "[ids] *", keyd will EVIOCGRAB the
  "TUXEDO Keyboard" device and forward its keys through the
  "keyd virtual keyboard" device. To keep working whether or not keyd grabs the
  device, this daemon watches both, with a debounce so events are not counted twice.

No external dependencies.
"""
import glob
import os
import select
import struct
import sys
import time

LED = os.environ.get("KBDLIGHT_LED", "/sys/class/leds/rgb:kbd_backlight")
BRIGHT = os.path.join(LED, "brightness")

KEY_KBDILLUMTOGGLE = 228
KEY_KBDILLUMDOWN = 229
KEY_KBDILLUMUP = 230
KEY_LIGHTS_TOGGLE = 542

STEP = 64                      # 255 / 4 steps, matching the kbdlight CLI
EV_KEY = 0x01
EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
DEBOUNCE = 0.08                # seconds
RESCAN = 5                     # seconds

WANTED_NAMES = ("TUXEDO Keyboard", "keyd virtual keyboard")
HANDLED = (KEY_KBDILLUMUP, KEY_KBDILLUMDOWN, KEY_KBDILLUMTOGGLE, KEY_LIGHTS_TOGGLE)

_last = {}


def log(*a):
    print(*a, flush=True)


def device_name(ev_sysfs):
    try:
        with open(os.path.join(ev_sysfs, "device/name")) as f:
            return f.read().strip()
    except OSError:
        return None


def device_has_keys(ev_sysfs):
    """Make sure this device actually advertises the backlight keys."""
    path = os.path.join(ev_sysfs, "device/capabilities/key")
    try:
        with open(path) as f:
            toks = f.read().split()
    except OSError:
        return False
    if not toks:
        return False
    # sysfs writes the highest word first
    words = [int(t, 16) for t in toks][::-1]
    for k in HANDLED:
        i, b = divmod(k, 64)
        if i < len(words) and (words[i] >> b) & 1:
            return True
    return False


def scan():
    """Find all relevant /dev/input/event* devices."""
    found = {}
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        name = device_name(ev)
        if name in WANTED_NAMES and device_has_keys(ev):
            found["/dev/input/" + os.path.basename(ev)] = name
    return found


def read_brightness():
    try:
        with open(BRIGHT) as f:
            return int(f.read().strip())
    except OSError:
        return 0


def write_brightness(value):
    value = max(0, min(255, value))
    try:
        with open(BRIGHT, "w") as f:
            f.write(str(value))
        return value
    except OSError as e:
        log(f"failed to write brightness: {e}")
        return None


def handle(code):
    now = time.monotonic()
    if now - _last.get(code, 0) < DEBOUNCE:
        return                                   # duplicate event from keyd
    _last[code] = now

    cur = read_brightness()

    if code == KEY_KBDILLUMUP:
        new = 255 if cur == 0 else cur + STEP
    elif code == KEY_KBDILLUMDOWN:
        new = cur - STEP
    elif code in (KEY_KBDILLUMTOGGLE, KEY_LIGHTS_TOGGLE):
        new = 0 if cur > 0 else 255
    else:
        return

    got = write_brightness(new)
    if got is not None:
        log(f"key {code}: brightness {cur} -> {got}")


def main():
    if not os.path.isdir(LED):
        log("LED rgb:kbd_backlight not found. Is the module loaded?")
        log("Run: sudo modprobe tuxedo_keyboard clevo_wmi clevo_acpi")
        return 1

    log("kbdlightd running, waiting for Fn + volume up/down...")
    fds = {}
    last_scan = 0.0

    while True:
        if time.monotonic() - last_scan > RESCAN or not fds:
            last_scan = time.monotonic()
            found = scan()
            for path, name in found.items():
                if path not in fds:
                    try:
                        fds[path] = (open(path, "rb", buffering=0), name)
                        log(f"watching {path} ({name})")
                    except OSError as e:
                        log(f"cannot open {path}: {e} (need the 'input' group)")
            # drop devices that have disappeared
            for path in list(fds):
                if path not in found:
                    try:
                        fds[path][0].close()
                    except OSError:
                        pass
                    del fds[path]
                    log(f"stopped watching {path}")

        if not fds:
            time.sleep(2)
            continue

        try:
            ready, _, _ = select.select([f for f, _ in fds.values()], [], [], 2)
        except OSError:
            fds.clear()
            continue

        for fd in ready:
            path = next(p for p, (f, _) in fds.items() if f is fd)
            try:
                data = fd.read(EVENT_SIZE)
            except OSError:
                data = None
            if not data or len(data) < EVENT_SIZE:
                try:
                    fd.close()
                except OSError:
                    pass
                fds.pop(path, None)
                continue
            _, _, etype, code, value = struct.unpack(EVENT_FMT, data)
            if etype == EV_KEY and value == 1:
                handle(code)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass
