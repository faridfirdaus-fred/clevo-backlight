#!/usr/bin/env bash
#
# kbdlight - kontrol backlight keyboard Clevo / Axioo Pongo 725 (NP50RNA) di Linux
#
# Pakai:
#   kbdlight                  nyalakan penuh, putih
#   kbdlight on               sama seperti di atas
#   kbdlight off              matikan
#   kbdlight toggle           nyala <-> mati (cocok untuk shortcut OS)
#   kbdlight up [langkah]     naikkan terang (default 64)
#   kbdlight down [langkah]   turunkan terang (default 64)
#   kbdlight level 0-255      set terang langsung
#   kbdlight color R G B      set warna (0-255 tiap kanal)
#   kbdlight color FF0000     set warna dari kode hex
#   kbdlight FF0000           singkatan dari "color FF0000"
#   kbdlight "255 128 0"      singkatan dari "color 255 128 0"
#   kbdlight 128              singkatan dari "level 128"
#   kbdlight status           tampilkan kondisi sekarang
#   kbdlight help             tampilkan bantuan ini
#
# Warna terakhir diingat di ~/.cache/kbdlight-color, jadi "up"/"down"/"toggle"
# tidak menghapus warna yang sedang dipakai.
#
set -uo pipefail

LED="${KBDLIGHT_LED:-/sys/class/leds/rgb:kbd_backlight}"
BRIGHT="$LED/brightness"
MAXB="$LED/max_brightness"
COLOR="$LED/multi_intensity"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/kbdlight-color"
DEFAULT_STEP=64

if [ ! -d "$LED" ]; then
  echo "kbdlight: backlight tidak ditemukan di $LED" >&2
  echo "  - Cek modul:  lsmod | grep -E 'tuxedo|clevo'" >&2
  echo "  - Muat:       sudo modprobe tuxedo_keyboard clevo_wmi clevo_acpi" >&2
  echo "  - Pasang:     sudo ./install.sh" >&2
  exit 1
fi

usage() {
  # cetak blok komentar di atas file (baris 2 sampai sebelum "set -uo pipefail")
  sed -n '2,/^set /p' "$0" | sed '$d' | sed 's/^#\{1,2\} \{0,1\}//'
}

# tulis ke file sysfs; kalau tidak punya izin, coba sudo
write() {  # $1=file $2=nilai
  if printf '%s' "$2" > "$1" 2>/dev/null; then
    return 0
  fi
  if command -v sudo >/dev/null 2>&1; then
    sudo -n sh -c "printf '%s' '$2' > '$1'" 2>/dev/null && return 0
    echo "kbdlight: butuh izin menulis $1" >&2
    echo "  - Masukkan user ke grup 'input', atau jalankan ulang install.sh" >&2
    return 1
  fi
  echo "kbdlight: tidak bisa menulis $1" >&2
  return 1
}

cur_bright() {
  local v
  v=$(cat "$BRIGHT" 2>/dev/null) || v=0
  printf '%s' "${v:-0}"
}

max_bright() {
  local v
  v=$(cat "$MAXB" 2>/dev/null) || v=255
  printf '%s' "${v:-255}"
}

# ingat warna terakhir supaya up/down/toggle tidak menghapusnya
save_color() { printf '%s %s %s\n' "$1" "$2" "$3" > "$STATE" 2>/dev/null || true; }
load_color() {
  local r g b
  if [ -r "$STATE" ]; then
    read -r r g b < "$STATE" 2>/dev/null || true
    if [ -n "${r:-}" ] && [ -n "${g:-}" ] && [ -n "${b:-}" ]; then
      printf '%s %s %s' "$r" "$g" "$b"; return
    fi
  fi
  printf '255 255 255'
}

set_color() {  # $1=R $2=G $3=B
  write "$COLOR" "$1 $2 $3" || return 1
  save_color "$1" "$2" "$3"
}

notify() {  # umpan balik opsional kalau ada notify-send (untuk shortcut OS)
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -t 1200 -h string:x-canonical-private-synchronous:kbdlight "$@"
}

apply_level() {  # $1=0-255
  local v=$1 max
  max=$(max_bright)
  [ "$v" -gt "$max" ] && v=$max
  [ "$v" -lt 0 ] && v=0
  write "$BRIGHT" "$v" || return 1
  echo "Brightness: $v/$max"
  notify "Backlight keyboard" "Terang: $v/$max"
}

clamp_level() {  # $1=level $2=max
  local v=$1 max=$2
  [ "$v" -gt "$max" ] && v=$max
  [ "$v" -lt 0 ] && v=0
  printf '%s' "$v"
}

is_uint() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

parse_hex() {  # $1=RRGGBB -> "r g b"
  local h=$1
  printf '%d %d %d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"
}

cmd="${1:-on}"; shift 2>/dev/null || true

case "$cmd" in
  on|"")
    set_color 255 255 255 || exit 1
    apply_level 255 || exit 1
    ;;

  off)
    apply_level 0 || exit 1
    ;;

  toggle)
    if [ "$(cur_bright)" -gt 0 ]; then
      apply_level 0 || exit 1
    else
      read -r r g b <<<"$(load_color)"
      set_color "$r" "$g" "$b" || exit 1
      apply_level 255 || exit 1
    fi
    ;;

  up|down)
    step="$DEFAULT_STEP"
    if is_uint "${1:-}"; then step="$1"; fi
    cur=$(cur_bright)
    if [ "$cmd" = up ]; then
      # dari 0 langsung nyala penuh, biar tidak perlu klik berkali-kali
      [ "$cur" -eq 0 ] && v=255 || v=$((cur + step))
    else
      v=$((cur - step))
    fi
    apply_level "$(clamp_level "$v" "$(max_bright)")" || exit 1
    ;;

  level)
    if ! is_uint "${1:-}"; then
      echo "kbdlight: 'level' butuh angka 0-255" >&2; exit 1
    fi
    apply_level "$(clamp_level "$1" "$(max_bright)")" || exit 1
    ;;

  color)
    set -- "$@"
    if [ "$#" -ge 3 ] && is_uint "$1" && is_uint "$2" && is_uint "$3"; then
      set_color "$1" "$2" "$3" || exit 1
      echo "Warna: RGB($1, $2, $3)"
      notify "Backlight keyboard" "Warna: RGB($1, $2, $3)"
    elif [ "$#" -eq 1 ] && [[ "$1" =~ ^[0-9A-Fa-f]{6}$ ]]; then
      read -r r g b <<<"$(parse_hex "$1")"
      set_color "$r" "$g" "$b" || exit 1
      echo "Warna: #$1 (RGB($r, $g, $b))"
      notify "Backlight keyboard" "Warna: #$1"
    else
      echo "kbdlight: 'color' butuh 'R G B' atau kode hex 6 digit" >&2
      exit 1
    fi
    apply_level 255 >/dev/null || exit 1
    ;;

  status)
    echo "led             : $LED"
    echo "brightness      : $(cur_bright)/$(max_bright)"
    echo "multi_intensity : $(cat "$COLOR" 2>/dev/null)"
    echo "warna tersimpan : $(load_color)"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    arg="$cmd"
    if [[ "$arg" =~ ^[0-9]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+$ ]]; then
      # "255 0 0"
      set_color $arg || exit 1
      apply_level 255 >/dev/null || exit 1
      echo "Warna: RGB($arg)"
    elif [[ "$arg" =~ ^[0-9A-Fa-f]{6}$ ]]; then
      # FF0000
      read -r r g b <<<"$(parse_hex "$arg")"
      set_color "$r" "$g" "$b" || exit 1
      apply_level 255 >/dev/null || exit 1
      echo "Warna: #$arg (RGB($r, $g, $b))"
    elif is_uint "$arg"; then
      # 128
      apply_level "$(clamp_level "$arg" "$(max_bright)")" || exit 1
    else
      echo "kbdlight: perintah tidak dikenal: $arg" >&2
      echo >&2
      usage >&2
      exit 1
    fi
    ;;
esac
