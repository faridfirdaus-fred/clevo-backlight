#!/usr/bin/env bash
#
# kbdlight - control the keyboard backlight on Clevo laptops (NP50RNA and similar) on Linux
#
# Usage:
#   kbdlight                  turn on fully, white
#   kbdlight on               same as above
#   kbdlight off              turn off
#   kbdlight toggle           on <-> off (handy for an OS shortcut)
#   kbdlight up [step]        increase brightness (default 64)
#   kbdlight down [step]      decrease brightness (default 64)
#   kbdlight level 0-255      set brightness directly
#   kbdlight color R G B      set color (0-255 per channel)
#   kbdlight color FF0000     set color from a hex code
#   kbdlight FF0000           shorthand for "color FF0000"
#   kbdlight "255 128 0"      shorthand for "color 255 128 0"
#   kbdlight 128              shorthand for "level 128"
#   kbdlight status           show the current state
#   kbdlight help             show this help
#
# The last color is remembered in ~/.cache/kbdlight-color, so "up"/"down"/"toggle"
# do not wipe the color currently in use.
#
set -uo pipefail

LED="${KBDLIGHT_LED:-/sys/class/leds/rgb:kbd_backlight}"
BRIGHT="$LED/brightness"
MAXB="$LED/max_brightness"
COLOR="$LED/multi_intensity"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/kbdlight-color"
DEFAULT_STEP=64

if [ ! -d "$LED" ]; then
  echo "kbdlight: backlight not found at $LED" >&2
  echo "  - Check the module:  lsmod | grep -E 'tuxedo|clevo'" >&2
  echo "  - Load it:           sudo modprobe tuxedo_keyboard clevo_wmi clevo_acpi" >&2
  echo "  - Install it:        sudo ./install.sh" >&2
  exit 1
fi

usage() {
  # print the comment block at the top of this file (line 2 up to "set -uo pipefail")
  sed -n '2,/^set /p' "$0" | sed '$d' | sed 's/^#\{1,2\} \{0,1\}//'
}

# write to a sysfs file; fall back to sudo if we lack permission
write() {  # $1=file $2=value
  if printf '%s' "$2" > "$1" 2>/dev/null; then
    return 0
  fi
  if command -v sudo >/dev/null 2>&1; then
    sudo -n sh -c "printf '%s' '$2' > '$1'" 2>/dev/null && return 0
    echo "kbdlight: need permission to write $1" >&2
    echo "  - Add your user to the 'input' group, or re-run install.sh" >&2
    return 1
  fi
  echo "kbdlight: cannot write $1" >&2
  return 1
}

cur_bright() {
  local v
  v=$(cat "$BRIGHT" 2>/dev/null) || v=0
  printf '%s' "${v:-0}"
}

max_bright() {
  local v
  v=$(cat "$MAXB" 2>/dev/null) || v=255
  printf '%s' "${v:-255}"
}

# remember the last color so up/down/toggle do not wipe it
save_color() { printf '%s %s %s\n' "$1" "$2" "$3" > "$STATE" 2>/dev/null || true; }
load_color() {
  local r g b
  if [ -r "$STATE" ]; then
    read -r r g b < "$STATE" 2>/dev/null || true
    if [ -n "${r:-}" ] && [ -n "${g:-}" ] && [ -n "${b:-}" ]; then
      printf '%s %s %s' "$r" "$g" "$b"; return
    fi
  fi
  printf '255 255 255'
}

set_color() {  # $1=R $2=G $3=B
  write "$COLOR" "$1 $2 $3" || return 1
  save_color "$1" "$2" "$3"
}

notify() {  # optional feedback via notify-send (useful when called from a shortcut)
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -t 1200 -h string:x-canonical-private-synchronous:kbdlight "$@"
}

apply_level() {  # $1=0-255
  local v=$1 max
  max=$(max_bright)
  [ "$v" -gt "$max" ] && v=$max
  [ "$v" -lt 0 ] && v=0
  write "$BRIGHT" "$v" || return 1
  echo "Brightness: $v/$max"
  notify "Keyboard backlight" "Brightness: $v/$max"
}

clamp_level() {  # $1=level $2=max
  local v=$1 max=$2
  [ "$v" -gt "$max" ] && v=$max
  [ "$v" -lt 0 ] && v=0
  printf '%s' "$v"
}

is_uint() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

parse_hex() {  # $1=RRGGBB -> "r g b"
  local h=$1
  printf '%d %d %d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"
}

cmd="${1:-on}"; shift 2>/dev/null || true

case "$cmd" in
  on|"")
    set_color 255 255 255 || exit 1
    apply_level 255 || exit 1
    ;;

  off)
    apply_level 0 || exit 1
    ;;

  toggle)
    if [ "$(cur_bright)" -gt 0 ]; then
      apply_level 0 || exit 1
    else
      read -r r g b <<<"$(load_color)"
      set_color "$r" "$g" "$b" || exit 1
      apply_level 255 || exit 1
    fi
    ;;

  up|down)
    step="$DEFAULT_STEP"
    if is_uint "${1:-}"; then step="$1"; fi
    cur=$(cur_bright)
    if [ "$cmd" = up ]; then
      # from 0, jump straight to full brightness so you do not have to press repeatedly
      [ "$cur" -eq 0 ] && v=255 || v=$((cur + step))
    else
      v=$((cur - step))
    fi
    apply_level "$(clamp_level "$v" "$(max_bright)")" || exit 1
    ;;

  level)
    if ! is_uint "${1:-}"; then
      echo "kbdlight: 'level' expects a number 0-255" >&2; exit 1
    fi
    apply_level "$(clamp_level "$1" "$(max_bright)")" || exit 1
    ;;

  color)
    set -- "$@"
    if [ "$#" -ge 3 ] && is_uint "$1" && is_uint "$2" && is_uint "$3"; then
      set_color "$1" "$2" "$3" || exit 1
      echo "Color: RGB($1, $2, $3)"
      notify "Keyboard backlight" "Color: RGB($1, $2, $3)"
    elif [ "$#" -eq 1 ] && [[ "$1" =~ ^[0-9A-Fa-f]{6}$ ]]; then
      read -r r g b <<<"$(parse_hex "$1")"
      set_color "$r" "$g" "$b" || exit 1
      echo "Color: #$1 (RGB($r, $g, $b))"
      notify "Keyboard backlight" "Color: #$1"
    else
      echo "kbdlight: 'color' expects 'R G B' or a 6-digit hex code" >&2
      exit 1
    fi
    apply_level 255 >/dev/null || exit 1
    ;;

  status)
    echo "led            : $LED"
    echo "brightness     : $(cur_bright)/$(max_bright)"
    echo "multi_intensity: $(cat "$COLOR" 2>/dev/null)"
    echo "saved color    : $(load_color)"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    arg="$cmd"
    if [[ "$arg" =~ ^[0-9]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+$ ]]; then
      # "255 0 0"
      set_color $arg || exit 1
      apply_level 255 >/dev/null || exit 1
      echo "Color: RGB($arg)"
    elif [[ "$arg" =~ ^[0-9A-Fa-f]{6}$ ]]; then
      # FF0000
      read -r r g b <<<"$(parse_hex "$arg")"
      set_color "$r" "$g" "$b" || exit 1
      apply_level 255 >/dev/null || exit 1
      echo "Color: #$arg (RGB($r, $g, $b))"
    elif is_uint "$arg"; then
      # 128
      apply_level "$(clamp_level "$arg" "$(max_bright)")" || exit 1
    else
      echo "kbdlight: unknown command: $arg" >&2
      echo >&2
      usage >&2
      exit 1
    fi
    ;;
esac
